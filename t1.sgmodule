[General]

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com, firebaseremoteconfigrealtime.googleapis.com, api.locketcamera.com

[Script]
# 1. Xóa Header Cache RevenueCat
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/andanh447/locketgold_tool/refs/heads/main/deleteheaderDHT.js, timeout=60

# 2. Fake Gold RevenueCat
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/andanh447/locketgold_tool/refs/heads/main/revenuecatDHT.js, requires-body=true, max-size=-1, timeout=60

# 3. Custom Khung Hello Kitty & Shin (Đã sửa lại link .js chuẩn)
locket_rc = type=http-response, pattern=^https?:\/\/firebaseremoteconfig.*\.googleapis\.com\/.*, script-path=https://raw.githubusercontent.com/andanh447/locketgold_tool/refs/heads/main/locketkhung_hellokitty-shin.js, requires-body=true, max-size=-1, timeout=60

# 4. Script Phá Lỗi 402/403, Bẻ khóa AI & Filter (Quan trọng nhất)
locket_filter_req = type=http-request, pattern=^https:\/\/api\.locketcamera\.com\/.+, max-size=-1, script-path=https://raw.githubusercontent.com/andanh447/locketgold_tool/refs/heads/main/locketfilter_andanh447.js, timeout=60
locket_filter_resp = type=http-response, pattern=^https:\/\/api\.locketcamera\.com\/.+, requires-body=true, max-size=-1, script-path=https://raw.githubusercontent.com/andanh447/locketgold_tool/refs/heads/main/locketfilter_andanh447.js, timeout=60
